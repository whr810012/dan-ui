{
  "name": "dan-ui",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.3",
  "scripts": {
    "dev:play": "pnpm --filter @dan-ui/playground dev",
    "dev:docs": "pnpm --filter @dan-ui/docs dev",
    "build": "pnpm --filter @dandan-ui/theme build && pnpm --filter @dandan-ui/ui build",
    "build:theme": "pnpm --filter @dandan-ui/theme build",
    "build:ui": "pnpm --filter @dandan-ui/ui build",
    "docs:build": "pnpm --filter @dan-ui/docs build",
    "test": "pnpm --filter @dandan-ui/ui test",
    "lint": "eslint . && prettier --check \"**/*.{ts,tsx,vue,js,mjs,cjs,css,json}\"",
    "lint:fix": "eslint . --fix && prettier --write \"**/*.{ts,tsx,vue,js,mjs,cjs,css,json}\"",
    "gen": "node ./scripts/gen-component.mjs",
    "bundle:report": "node ./scripts/bundle-report.mjs",
    "publish:packages": "pnpm build && pnpm --filter @dandan-ui/theme publish --access public && pnpm --filter @dandan-ui/ui publish --access public"
  },

  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
