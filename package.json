{
  "name": "dan-ui",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.3",
  "scripts": {
    "dev:play": "pnpm --filter @dan-ui/playground dev",
    "dev:docs": "pnpm --filter @dan-ui/docs dev",
    "build": "pnpm --filter @dan-ui/theme build && pnpm --filter @dan-ui/ui build",
    "build:theme": "pnpm --filter @dan-ui/theme build",
    "build:ui": "pnpm --filter @dan-ui/ui build",
    "docs:build": "pnpm --filter @dan-ui/docs build",
    "test": "pnpm --filter @dan-ui/ui test",
    "lint": "echo \"lint: not configured yet\"",
    "gen": "node ./scripts/gen-component.mjs"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
