{
  "name": "@dan-ui/ui",
  "version": "0.0.1",
  "description": "Vue 3 UI component library — dan-ui",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
