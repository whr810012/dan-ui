{
  "name": "@dan-ui/ui",
  "version": "1.0.0",
  "description": "Vue 3 UI component library — dan-ui",
  "type": "module",
  "license": "MIT",
  "author": "wangdandan810012",
  "homepage": "https://github.com/whr810012/dan-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whr810012/dan-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/whr810012/dan-ui/issues"
  },
  "keywords": [
    "dan-ui",
    "vue",
    "vue3",
    "components",
    "ui-library"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js",
      "require": "./dist/resolver.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/vue-3": "^3.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/vue-3": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/extension-placeholder": {
      "optional": true
    },
    "@tiptap/extension-image": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    }
  },
  "dependencies": {
    "@dan-ui/theme": "workspace:*",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@tiptap/extension-bubble-menu": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.1.4",
    "vue": "^3.5.13"
  }
}
